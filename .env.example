# Copy to .env. Loaded by the backend (pydantic-settings). All keys are prefixed TRADEDISHA_.

# Upstox API application credentials (register at https://account.upstox.com/developer/apps)
# Needed from Milestone 1.
TRADEDISHA_UPSTOX_API_KEY=
TRADEDISHA_UPSTOX_API_SECRET=
TRADEDISHA_UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Server
TRADEDISHA_BIND_HOST=127.0.0.1
TRADEDISHA_BIND_PORT=8000
