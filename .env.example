# Copy to .env. Loaded by the backend (pydantic-settings). All keys are prefixed TRADEDISHA_.
# Every key matches a field of backend/tradedisha/config.py:Settings; a change needs a
# restart. Commented keys show the default. Signal parameters are not here: they are edited
# and versioned in the app (Config), and config/params.toml only seeds version 1.

# Upstox API application credentials (register at https://account.upstox.com/developer/apps)
# Needed only for TRADEDISHA_FEED_PROVIDER=upstox. The redirect URI must match the one
# registered for the app exactly.
TRADEDISHA_UPSTOX_API_KEY=
TRADEDISHA_UPSTOX_API_SECRET=
TRADEDISHA_UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Server
TRADEDISHA_BIND_HOST=127.0.0.1
TRADEDISHA_BIND_PORT=8000
# Where the Upstox login sends the browser back to when the backend does not serve the
# frontend itself (the Vite dev server).
# TRADEDISHA_FRONTEND_URL=http://localhost:5173
# TRADEDISHA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Serve the built web app from the backend (make start sets this).
# TRADEDISHA_SERVE_FRONTEND=false
# TRADEDISHA_FRONTEND_DIST=frontend/dist
# Restart the dev server when backend code changes.
# TRADEDISHA_RELOAD=true

# Feed: synthetic | replay | upstox
# upstox = live market data; press Login in the top bar once a day (token ends 03:30 IST).
TRADEDISHA_FEED_PROVIDER=synthetic
# Keep live recordings apart from synthetic ones (both use the key "NSE_INDEX|Nifty 50").
# Relative paths are taken from the repository root. Use the same file for replay of live days.
# TRADEDISHA_DB_PATH=data/live.sqlite
# Instrument-master cache (relative to the repository root, like DB_PATH).
# TRADEDISHA_DATA_DIR=data
# The indices followed.
# TRADEDISHA_INDICES=["NIFTY","BANKNIFTY"]
# Sector indices per index (display only) are TRADEDISHA_SECTOR_INDICES, a JSON object of
# index -> list of Upstox index names; see the default in config.py.

# Synthetic feed
# TRADEDISHA_SYNTHETIC_TICKS_PER_SECOND=2.0
# Fixed seed for a repeatable random walk; leave unset for a new walk each start.
# TRADEDISHA_SYNTHETIC_SEED=42
# Upward drift in strike steps per spot tick, to exercise re-centring; 0 = mean-reverting.
# TRADEDISHA_SYNTHETIC_TREND_PER_TICK=0.0

# Replay feed
# TRADEDISHA_REPLAY_DATE=2026-11-12
# 0 = as fast as possible.
# TRADEDISHA_REPLAY_SPEED=1.0
# Fault injection on replay: withhold ticks in these IST time ranges.
# TRADEDISHA_REPLAY_DROP=["10:05:00-10:07:30"]
# Also replay the day's bullion and macro ticks (gold, silver, currency futures, crude).
# Off by default because MCX trades until 23:30, so the replay runs long past the NSE close.
# TRADEDISHA_REPLAY_BULLION=false

# Market hours (IST). The files take absolute paths if moved.
# TRADEDISHA_MARKET_OPEN=09:15
# TRADEDISHA_MARKET_CLOSE=15:30
# TRADEDISHA_PRE_OPEN_START=09:00
# TRADEDISHA_HOLIDAYS_FILE=/absolute/path/to/config/nse-holidays.txt
# MCX closes at 23:55 while the US is on standard time (roughly November to March) and at
# 23:30 otherwise: change it with the season.
# TRADEDISHA_MCX_OPEN=09:00
# TRADEDISHA_MCX_CLOSE=23:30
# TRADEDISHA_MCX_HOLIDAYS_FILE=/absolute/path/to/config/mcx-holidays.txt
# Stocks whose headlines are shown (at most 30).
# TRADEDISHA_NEWS_STOCKS_FILE=/absolute/path/to/config/news-stocks.txt
# Starting parameters for a new database.
# TRADEDISHA_PARAMS_PATH=/absolute/path/to/config/params.toml

# Signals and liveness
# Signal and paper-trade hours: true or false overrides; leave unset to enforce them unless
# the feed is synthetic.
# TRADEDISHA_ENFORCE_SIGNAL_HOURS=true
# Annual risk-free rate for Greeks computed when the feed has none.
# TRADEDISHA_RISK_FREE_RATE=0.065
# The NSE feed counts as live while its newest tick is younger than this.
# TRADEDISHA_FEED_LIVE_MAX_TICK_AGE_MS=5000
# The same for bullion, judged against MCX hours.
# TRADEDISHA_BULLION_LIVE_MAX_TICK_AGE_MS=15000
# Option chain: strikes either side of the centre, and how far spot moves before it
# re-centres. These are what the chain uses (the chain.* parameters in Config are not read).
# TRADEDISHA_STRIKE_WINDOW=10
# TRADEDISHA_RECENTER_STRIKES=2

# WebSocket push: most tick and chain frames per second per index.
# TRADEDISHA_WS_TICK_HZ=20.0
# TRADEDISHA_WS_CHAIN_HZ=2.0
