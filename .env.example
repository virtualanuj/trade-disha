# Copy to .env. Loaded by the backend (pydantic-settings). All keys are prefixed TRADEDISHA_.

# Upstox API application credentials (register at https://account.upstox.com/developer/apps)
# Needed only for TRADEDISHA_FEED_PROVIDER=upstox. The redirect URI must match the one
# registered for the app exactly.
TRADEDISHA_UPSTOX_API_KEY=
TRADEDISHA_UPSTOX_API_SECRET=
TRADEDISHA_UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Server
TRADEDISHA_BIND_HOST=127.0.0.1
TRADEDISHA_BIND_PORT=8000

# Feed: synthetic | replay | upstox
# upstox = live market data; press Login in the top bar once a day (token ends 03:30 IST).
TRADEDISHA_FEED_PROVIDER=synthetic
# Keep live recordings apart from synthetic ones (both use the key "NSE_INDEX|Nifty 50").
# Relative paths are taken from the repository root. Use the same file for replay of live days.
# TRADEDISHA_DB_PATH=data/live.sqlite
# TRADEDISHA_SYNTHETIC_TREND_PER_TICK=0.0
# TRADEDISHA_REPLAY_DATE=2026-11-12
# TRADEDISHA_REPLAY_SPEED=1.0
